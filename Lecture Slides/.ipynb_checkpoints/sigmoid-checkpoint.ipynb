   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "5ba5cfdc-36fa-4879-ad2f-f659bf317609",
   "metadata": {},
   "outputs": [],
   "source": [
    "x=np.arange(-10,10,0.05)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "3da9e0cc-6657-49ca-96e9-2125246f185e",
   "metadata": {},
   "outputs": [],
   "source": [
    "sigmoid=lambda a: 1/(1+np.exp(-a))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "2c9374a5-c8e5-4012-8e32-0cb27372c7ac",
   "metadata": {},
   "outputs": [],
   "source": [
    "y=sigmoid(x)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 43,
   "id": "ddf84935-8325-40ed-b9c8-4ce5eda4aade",
   "metadata": {},
